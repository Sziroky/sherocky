---
import { u } from '../scripts/url';
import { Picture } from 'astro:assets';
import wide from '../assets/photos/hero-wide.jpg';
import tall from '../assets/photos/hero-tall.jpg';
import wordmark from '../assets/wordmark.svg?raw';
import { upcoming, fmtDate } from '../scripts/concerts';
const next = upcoming()[0];
---
<section class="hero" aria-label="Sherocky">
  <div class="media" aria-hidden="true">
    <Picture src={wide} alt="" formats={['avif', 'webp']} widths={[960, 1600, 2400]} sizes="100vw" class="img-wide" loading="eager" fetchpriority="high" />
    <Picture src={tall} alt="" formats={['avif', 'webp']} widths={[640, 1000, 1400]} sizes="100vw" class="img-tall" loading="eager" />
  </div>
  <div class="wrap content">
    <h1 class="title">
      <span class="visually-hidden">Sherocky</span>
      <span class="word" set:html={wordmark} aria-hidden="true" />
    </h1>
    <p class="lede">Pięciu kumpli i rock'n'roll, który nie zostaje na scenie, tylko przejmuje <em>całą salę</em>.</p>
    <p class="sub label">Koncerty · dni gminy · zloty · wesela (jako koncert) · Polonia</p>
    <div class="ctas" data-hide-sticky>
      <a class="btn" href={u('/oferta#zapytanie')}>Zarezerwuj koncert <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#koncerty">Najbliższe koncerty</a>
    </div>
  </div>
  {next && (
    <a class="next" href={u('/koncerty')}>
      <span class="dot" aria-hidden="true"></span>
      <span class="label">Najbliższy koncert</span>
      <span class="mono">{fmtDate(next.date)} · {next.private ? 'Wydarzenie prywatne' : next.title} · {next.place}</span>
    </a>
  )}
</section>

<style>
  .hero {
    position: relative; min-height: 100svh;
    display: grid; align-content: end;
    padding: 7rem 0 0; overflow: hidden; isolation: isolate;
  }
  .media { position: absolute; inset: 0; z-index: -1; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .media :global(.img-wide) { object-position: 50% 30%; }
  .media :global(.img-tall) { display: none; object-position: 50% 40%; }
  .media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to top, var(--ink) 0%, rgb(15 12 11 / .85) 28%, rgb(15 12 11 / .35) 60%, rgb(15 12 11 / .55) 100%);
  }
  @media (max-aspect-ratio: 4/5) {
    .media :global(.img-wide) { display: none; }
    .media :global(.img-tall) { display: block; }
  }
  .content { display: grid; gap: 1.5rem; padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .title { line-height: 1; }
  .word { display: block; width: min(100%, 46rem); color: var(--cream); }
  .word :global(svg) { width: 100%; height: auto; display: block; filter: drop-shadow(0 4px 24px rgb(0 0 0 / .45)); }
  .lede { font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem); line-height: 1.35; max-width: 30ch; margin: 0; }
  .lede em { font-style: italic; color: var(--amber); }
  .sub { color: var(--muted); margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .5rem; }
  @media (max-width: 30rem) { .ctas .btn { flex: 1 1 100%; } }

  .next {
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem;
    padding: 1rem var(--gutter);
    border-top: 1px solid var(--line); background: rgb(15 12 11 / .9);
    text-decoration: none; color: var(--cream);
    transition: background .3s var(--ease);
  }
  .next:hover { background: var(--surface); }
  .next .mono { font-size: .9375rem; }
  .dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--red-light); box-shadow: 0 0 0 0 var(--red-light); animation: onair 2.4s infinite; }
  @keyframes onair {
    0% { box-shadow: 0 0 0 0 rgb(240 86 58 / .6); }
    70% { box-shadow: 0 0 0 10px rgb(240 86 58 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(240 86 58 / 0); }
  }
</style>
