---
import { Picture } from 'astro:assets';
import vocal from '../assets/photos/live-vocal.jpg';
import guitar from '../assets/photos/live-guitar.jpg';
import vest from '../assets/photos/vest.jpg';
---
<section class="section listen" id="posluchaj">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="label">Posłuchaj · Sesje z sali prób</p>
      <h2>Tak brzmimy,<br />kiedy nikt nie patrzy</h2>
      <p>Pięć utworów nagranych na żywo w naszej sali prób: po jednym z każdej Piguły i coś ekstra. <span class="todo">Nagrania wkrótce.</span> Na razie zdjęcia z prób. Głośność dopowiedz sobie sam.</p>
    </header>
    <div class="grid">
      <figure class="a reveal">
        <Picture src={vocal} alt="Gitarzysta z długimi włosami śpiewa podczas próby" formats={['avif', 'webp']} widths={[640, 1200, 1800]} sizes="(min-width: 60rem) 66vw, 100vw" />
        <figcaption class="mono">Sesja #1 · <span class="todo">wkrótce</span></figcaption>
      </figure>
      <figure class="b reveal">
        <Picture src={guitar} alt="Gitarzysta w rozkroku gra na czerwonym Les Paulu" formats={['avif', 'webp']} widths={[480, 900]} sizes="(min-width: 60rem) 33vw, 100vw" />
      </figure>
      <figure class="c reveal">
        <Picture src={vest} alt="Kamizelka z naszywką California, widok od tyłu" formats={['avif', 'webp']} widths={[480, 900]} sizes="(min-width: 60rem) 33vw, 100vw" />
      </figure>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: .75rem; }
  figure { margin: 0; position: relative; overflow: hidden; background: var(--surface); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  figure:hover :global(img) { transform: scale(1.03); }
  figcaption { position: absolute; left: 1rem; bottom: 1rem; font-size: .8125rem; letter-spacing: .08em; background: rgb(15 12 11 / .85); padding: .35rem .6rem; }
  .a { aspect-ratio: 16 / 10; }
  .b, .c { aspect-ratio: 4 / 5; }
  @media (min-width: 40rem) { .grid { grid-template-columns: 1fr 1fr; } .a { grid-column: 1 / -1; } }
  @media (min-width: 60rem) {
    .grid { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; height: min(80vh, 46rem); }
    .a { grid-row: 1 / 3; grid-column: 1; aspect-ratio: auto; }
    .b, .c { aspect-ratio: auto; }
  }
</style>
