---
import { u } from '../scripts/url';
import Base from '../layouts/Base.astro';
---
<Base title="404 · Sherocky">
  <section class="section nf">
    <div class="wrap">
      <p class="label">Błąd 404</p>
      <h1>Tej strony<br />nie ma</h1>
      <p class="muted">Kronikarze szukają, ale najpewniej odleciała razem ze stołem na koncercie Cadillaców.</p>
      <a class="btn" href={u('/')}>Wróć na scenę <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
<style>.nf { padding-top: 10rem; min-height: 80vh; } h1 { font-size: clamp(4rem, 3rem + 8vw, 9rem); margin: 1rem 0 1.5rem; }</style>
