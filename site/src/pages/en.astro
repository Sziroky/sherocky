---
import Base from '../layouts/Base.astro';
import offer from '../data/offer.json';
const tel = offer.contact.phone.replace(/\s/g, '');
---
<Base lang="en" title="Sherocky: live rock'n'roll band from Poland" description="Five mates from Opole, Poland, and rock'n'roll that takes over the whole room. Polish classics and world hits for Polish community events abroad.">
  <section class="section en-top">
    <div class="wrap grid">
      <div>
        <p class="label">Sherocky · Opole, Poland</p>
        <h1>Rock'n'roll<br />that takes over<br />the room</h1>
      </div>
      <div class="txt">
        <p>Five mates from southern Poland playing live rock'n'roll: town festivals, biker rallies, wedding concert sets and <strong>Polish community events abroad</strong>.</p>
        <p class="muted">Legendary, at least at the municipal level.</p>
      </div>
    </div>
  </section>
  <section class="section" id="offer">
    <div class="wrap">
      <p class="label">Offer</p>
      <h2>Three pills</h2>
      <ol class="pl">
        <li><h3>Polska Piguła</h3><p>Polish classics everyone sings along to. Perfect for Polonia events.</p></li>
        <li><h3>Światowa Piguła</h3><p>Rock'n'roll hits from around the world.</p></li>
        <li><h3>Piguła à la carte</h3><p>Our pick from both, plus our own songs.</p></li>
      </ol>
      <p>Sets of 30, 60 or 90 minutes. Own PA available. We travel abroad: transport and accommodation quoted individually. <span class="todo">EN price calculator: coming soon</span></p>
    </div>
  </section>
  <section class="section" id="contact">
    <div class="wrap">
      <p class="label">Contact</p>
      <h2>Talk to {offer.contact.person}</h2>
      <p><a class="link" href={`mailto:${offer.contact.email}`}>{offer.contact.email}</a> · <a class="link" href={`tel:${tel}`}>{offer.contact.phone}</a> · <a class="link" href={`https://wa.me/${tel.replace('+', '')}`}>WhatsApp</a></p>
      <p class="muted">We speak English (and Polish, obviously).</p>
    </div>
  </section>
</Base>
<style>
  .en-top { padding-top: 10rem; }
  .grid { display: grid; gap: 2rem; }
  @media (min-width: 60rem) { .grid { grid-template-columns: 1.3fr 1fr; align-items: end; } }
  h1 { font-size: clamp(3.5rem, 2rem + 7vw, 7.5rem); }
  .txt p { font-size: 1.2em; }
  .pl { list-style: none; padding: 0; margin: 2.5rem 0; border-top: 1px solid var(--line); }
  .pl li { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .pl p { margin: .5rem 0 0; color: var(--muted); }
  h2 { margin: 1rem 0 1.5rem; }
</style>
